*
  box-sizing border-box

body
  margin 0
  font-family -apple-system, "Helvetica Neue", "PingFang TC", sans-serif
  height 100vh
  display flex
  background #f5f5f2

.bar
  font 11px Menlo, monospace
  color #888
  padding 6px 12px
  border-bottom 1px solid #eee
  background #fff
  white-space nowrap
  overflow hidden
  text-overflow ellipsis
  b
    color #333

.files
  width 220px
  min-width 180px
  border-right 1px solid #ddd
  background #fff
  display flex
  flex-direction column

#file-tree
  flex 1
  min-height 0
  overflow auto
  padding 6px 0
  font 12px Menlo, monospace

  .row
    padding 3px 12px 3px 0
    white-space nowrap
    color #444
    cursor default
    &.file
      cursor pointer
      &:hover
        background #f0f4f8
    &.on
      background #e6effa
      color #1a4d8f
      font-weight 600
    // 目錄本身不是點擊目標 —— 預覽的對象是 block, 不是資料夾
    &.dir
      color #999

  .empty
    padding 10px 12px
    color #bbb

#chat-root
  width 380px
  min-width 300px
  border-right 1px solid #ddd
  background #fff

.main
  flex 1
  min-width 0
  display flex
  flex-direction column

#sandbox-root
  flex 1
  min-height 0
  padding 20px
  overflow auto
