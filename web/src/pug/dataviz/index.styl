*
  box-sizing border-box

body
  margin 0
  font-family -apple-system, "Helvetica Neue", "PingFang TC", sans-serif
  height 100vh
  display flex
  background #f5f5f2

.bar
  font 11px Menlo, monospace
  color #888
  padding 6px 12px
  border-bottom 1px solid #eee
  background #fff
  display flex
  justify-content space-between
  gap 8px
  white-space nowrap
  overflow hidden
  b
    color #333
    font-weight 600

#chat-root
  width 400px
  min-width 320px
  border-right 1px solid #ddd
  background #fff

.main
  flex 1
  min-width 0
  display flex
  flex-direction column

#sandbox-root
  flex 1
  min-height 0
  padding 20px
  overflow auto

.sheet-pane
  height 220px
  border-top 1px solid #ddd
  background #fff
  display flex
  flex-direction column
  .bar
    border-bottom 1px solid #eee

#sheet-root
  flex 1
  min-height 0
  overflow hidden

// 用量顯示 — 額度撐不住時要一眼看得出來
#current
  overflow hidden
  text-overflow ellipsis
  min-width 0

#usage
  display flex
  flex-shrink 0
  max-width 55%
  align-items center
  gap 8px
  font-size 12px
  select
    font-size 12px
    padding 2px 4px
    border 1px solid #ccc
    border-radius 4px
    // 帳號名字可能很長 (demo 那幾個就是), 不夾住的話會把餘額擠出畫面 ——
    // 而餘額正是撞上限時最需要看到的那個數字
    max-width 180px
    text-overflow ellipsis
  #balance
    color #888
    font-variant-numeric tabular-nums
    &.warn
      color #b26a00
    &.over
      color #c62828
      font-weight bold
