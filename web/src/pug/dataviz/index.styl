*
  box-sizing border-box

body
  margin 0
  font-family -apple-system, "Helvetica Neue", "PingFang TC", sans-serif
  height 100vh
  display flex
  background #f5f5f2

.bar
  font 11px Menlo, monospace
  color #888
  padding 6px 12px
  border-bottom 1px solid #eee
  background #fff
  display flex
  justify-content space-between
  gap 8px
  white-space nowrap
  overflow hidden
  b
    color #333
    font-weight 600

#chat-root
  width 400px
  min-width 320px
  border-right 1px solid #ddd
  background #fff

.main
  flex 1
  min-width 0
  display flex
  flex-direction column

#sandbox-root
  flex 1
  min-height 0
  padding 20px
  overflow auto

.sheet-pane
  height 220px
  border-top 1px solid #ddd
  background #fff
  display flex
  flex-direction column
  .bar
    border-bottom 1px solid #eee

#sheet-root
  flex 1
  min-height 0
  overflow hidden
