doctype html
html
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title Block Agent (browser runtime)
    script(src="https://cdn.jsdelivr.net/npm/d3@7/dist/d3.min.js")
    script(src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js")
    script(src="/assets/lib/proxise/main/index.min.js")
    script(src="/assets/lib/@plotdb/semver/main/index.min.js")
    script(src="/assets/lib/@plotdb/csscope/main/index.min.js")
    script(src="/assets/lib/@plotdb/rescope/main/index.min.js")
    script(src="/assets/lib/@plotdb/block/main/index.min.js")
    link(rel="stylesheet" href="/assets/lib/@plotdb/sheet/main/index.min.css")
    script(src="/assets/lib/@plotdb/sheet/main/index.min.js")
    link(rel="stylesheet" href="/assets/lib/@plotdb/esh/main/esh-term.iife.css")
    script(src="/assets/lib/@plotdb/esh/main/esh-term.iife.js")
    style(type="text/css").
      * { box-sizing: border-box; }
      body { margin: 0; font-family: -apple-system, "Helvetica Neue", "PingFang TC", sans-serif; height: 100vh; display: flex; background: #f5f5f2; }
      #chat-root { width: 420px; min-width: 320px; border-right: 1px solid #ddd; background: #fff; }
      .main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
      #sandbox-root { flex: 1; min-height: 0; padding: 20px; overflow: auto; }
      .sheet-pane { height: 200px; border-top: 1px solid #ddd; background: #fff; display: flex; flex-direction: column; }
      .sheet-bar { font: 11px Menlo, monospace; color: #888; padding: 4px 10px; border-bottom: 1px solid #eee; display: flex; justify-content: space-between; }
      .sheet-bar b { color: #333; font-weight: 600; }
      #sheet-root { flex: 1; min-height: 0; overflow: hidden; }
      .term-pane { height: 240px; border-top: 1px solid #ddd; background: #1e1e1e; display: flex; flex-direction: column; }
      .term-bar { font: 11px Menlo, monospace; color: #aaa; padding: 4px 10px; border-bottom: 1px solid #333; display: flex; justify-content: space-between; }
      .term-bar b { color: #ddd; font-weight: 600; }
      #term-root { flex: 1; min-height: 0; }
  body
    #chat-root
    .main
      #sandbox-root
      .sheet-pane
        .sheet-bar
          span
            b sheet
            |  — 資料由應用層持有, 改這裡圖會跟著重畫
          span#sheet-info
        #sheet-root
      .term-pane
        .term-bar
          span
            b workspace shell
            |  — agent 與你共用同一份 working tree
          span#persist-info
        #term-root

    script(type="module").
      import {createRuntime} from '/assets/lib/@plotdb/wagent/main/runtime/client.js';
      // 開發期避免模組快取 (與上面 block registry 的 ?t= 同一個理由) —
      // 沒有它時改了 app 程式碼卻沒生效, 會被誤判成邏輯有問題
      const {createStore} = await import('/assets/lib/dataviz/main/sheet-store.js?t=' + Date.now());
      const {seed} = await import('/assets/lib/dataviz/main/seed.js?t=' + Date.now());

      // ── 應用層的文件狀態 ──────────────────────────────────────────────
      // 資料由應用層持有 (Tier 1)。block 拿到的是「值」, 不是檔案路徑 —
      // 對照 makechart 的 host.local.raw / composer 的 nodemgr。
      var store = createStore();

      var params = new URLSearchParams(location.search);
      var blockName = params.get('block');  // null = 新增模式
      var chat = null;                      // open_block tool 要用, 稍後才建立
      var API = '/api/agent';
      var BLOCKS = '/assets/lib/@plotdb/wagent/main/block/';

      // app block (chat / sandbox 及其 base 層) 的 registry
      var paths = {
        'chat-base': 'chat/base.html',
        'chat': 'chat/index.html',
        'sandbox-base': 'sandbox/base.html',
        'sandbox': 'sandbox/index.html'
      };
      var mgr = new block.manager({
        registry: function(o) {
          if(o.type === 'block') {
            if(!paths[o.name]) { return null; }
            return BLOCKS + paths[o.name] + '?t=' + Date.now();
          }
          return '/assets/lib/' + o.name + '/' + (o.version || 'main') + '/' + (o.path || 'index.min.js');
        }
      });

      function create(name, root, data) {
        return mgr.get({name: name})
          .then(function(cls) { return cls.create({root: root, data: data}); })
          .then(function(inst) { return inst.interface(); });
      }

      // devices: 把應用層的文件狀態以檔案形式給 agent — 它就能用 grep / wc / head 去查,
      // 不必為每種資料各開一個 tool (host.md 的取捨準則: 能用指令表達的就別當 tool)
      createRuntime({api: API, devices: ['sheet']})
        .then(function(rt) {
          window.rt = rt;  // 方便在 console 觀察 (rt.sh.run / rt.io)
          document.getElementById('persist-info').textContent = rt.sh.ready ? '' : '';
          // 終端與 agent 共用同一個 worker (同一個 shell、同一份 workspace)
          eshTerm.createTerminal(document.getElementById('term-root'), {
            worker: rt.worker, home: rt.root
          });
          // workspace 的初始內容由應用層植入 (wagent 不決定新使用者看到什麼)
          return seed(rt.io).catch(function(e) {
            console.warn('seed failed', e);
          }).then(function() { return rt; });   // base 層不必預載: block 的 pkg.extend 會自己經 manager 解析
        })
        .then(function(rt) {
          // ── 應用層決定 block 拿到什麼資料 ──────────────────────────────
          // wagent 對資料的語意一無所知, 它只負責把這個物件交給 block。
          // 給的是解析好的值 ({columns, rows}), block 不讀檔、不持有路徑,
          // 換個環境換份資料就能跑。
          //
          // loadText / loadJSON 仍附上, 給還在用舊寫法的既有 block (過渡)。
          var dataFor = function(name) {
            var v = store.value();
            return {
              columns: v.columns, rows: v.rows,
              loadText: rt.io.loadText, loadJSON: rt.io.loadJSON
            };
          };
          return create('sandbox', document.getElementById('sandbox-root'),
                        {api: API, io: rt.io, data: dataFor})
            .then(function(sb) {
              window.sb = sb;  // 方便在 console 觀察 (sb.snapshot)
              window.store = store;

              // ── 試算表: 使用者編輯資料的地方 ────────────────────────────
              var sheetInfo = document.getElementById('sheet-info');
              function showInfo() {
                sheetInfo.textContent = store.value().rows.length + ' rows x ' +
                  store.dimensions.length + ' cols';
              }
              var sh = window.__sh = new sheet({root: '#sheet-root', data: store.raw()});
              var fromSheet = false;
              sh.on('change', function() {
                fromSheet = true;
                store.setRaw(sh.data());
                fromSheet = false;
              });
              // 文件狀態變了 -> 應用層決定重畫。與 fs 變更是同一個模式:
              // 「我正在看的東西變了」由應用層判斷, 不是 chat 也不是 agent。
              //
              // store 是唯一真相, sheet UI 只是它的一個視圖 — 所以同步要放在這裡,
              // 而不是放在某個特定的寫入路徑上。之前只在 write_sheet 裡同步,
              // 結果從別的來源改 store 時 UI 就跟真值分岔了 (畫面顯示舊資料, 圖卻是新的)。
              // device 是唯讀鏡像, 應用層是唯一真相 — 每次變更都推過去
              function pushDevice() { rt.setDevice('sheet', store.toCSV()); }
              pushDevice();
              store.on(function() {
                pushDevice();
                showInfo();
                if(!fromSheet) { sh.data(store.raw()); }
                // 資料變了 -> 有實作 client.data 的 block 增量更新, 其餘重掛
                if(sb.current()) { sb.updateData(); }
              });
              showInfo();
              // sandbox 即 host 的觀察通道: 把 snapshot 交給 agent
              // ── 誰決定重畫: application ────────────────────────────────
              // 兩件不同的事:
              //  1. 「我正在看的東西變了」-> fs 變更事件 (來源不只 agent:
              //     使用者的終端機、之後頁面上的 codemirror 都算)
              //  2. 「換一個東西給我看」  -> agent 明講的 open_block tool
              // 先前是用 write_file 的路徑去猜, 兩件事混在一起, 而且只猜得到 agent。
              function currentDir() {
                return sb.current() ? 'blocks/' + sb.current() + '/' : null;
              }
              rt.onFsChange(function(o) {
                if(!sb.current()) { return; }
                // paths 為 null = shell 動過但不知動了什麼 -> 保守重畫
                if(!o.paths) { return sb.refresh(); }
                var dir = currentDir();
                var hit = o.paths.some(function(p) {
                  var rel = p.indexOf(rt.root + '/') === 0 ? p.slice(rt.root.length + 1) : p;
                  return rel.indexOf(dir) === 0 || rel.indexOf('data/') === 0;
                });
                if(hit) { sb.refresh(); }
              });

              rt.registerHost({
                // 應用層自己的 tool。wagent 不需要知道「block」是什麼 —
                // composer 在這裡註冊的會是「開啟某個 node」之類的東西。
                tools: [{
                  name: 'write_sheet',
                  description: 'Replace the whole spreadsheet with the given CSV (first row must be the header). ' +
                    'Use this to put sample data in. The chart redraws automatically.',
                  parameters: {
                    type: 'object',
                    properties: {csv: {type: 'string', description: 'full CSV including the header row'}},
                    required: ['csv'],
                    additionalProperties: false
                  }
                }, {
                  name: 'open_block',
                  description: 'Show a block in the preview pane, making it the current editing target. ' +
                    'Call this after creating a NEW block — otherwise the user keeps looking at the previous one. ' +
                    'Not needed after editing the block that is already open (the preview refreshes by itself).',
                  parameters: {
                    type: 'object',
                    properties: {name: {type: 'string', description: 'block directory name under blocks/'}},
                    required: ['name'],
                    additionalProperties: false
                  }
                }],
                run: function(name, args) {
                  if(name === 'write_sheet') {
                    var n = store.fromCSV(args && args.csv);
                    return Promise.resolve('sheet now has ' + n + ' data rows');
                  }
                  if(name === 'open_block') {
                    var n = (args && args.name || '').trim();
                    if(!n) { return Promise.reject(new Error('name is required')); }
                    sb.show(n);
                    if(chat) { chat.setBlock(n); }
                    // 不必等渲染: snapshot 自己會等 sandbox 的 rendering
                    return Promise.resolve('now showing ' + n);
                  }
                  if(name !== 'snapshot') {
                    return Promise.reject(new Error('unknown host tool: ' + name));
                  }
                  return sb.snapshot(args).then(function(r) {
                    var text = JSON.stringify(r.report, null, 1);
                    // tool 結果可以是字串, 或 {text, image} — provider 各自轉成自己的格式
                    return r.image ? {text: text, image: r.image} : text;
                  });
                },
                // 靜態: 這是什麼應用。併進 system prompt (快取前綴)
                brief: [
                  '這個環境是一個 block 編輯器: 左邊是對話, 右邊即時渲染「目前開啟的 block」,',
                  '中間是一張試算表 — 圖表的資料來源, 用戶可以直接編輯, 改了圖就會重畫。',
                  '試算表以唯讀檔案 dev/sheet 呈現 (csv): 用 cat / grep / wc / head 直接查, 不必另外開 tool。',
                  '要改資料用 write_sheet。block 那端則由執行環境注入 opt.data, 不必自己讀。',
                  '最下面是一個與你共用同一份 workspace 的終端機 (用戶可能會自己動檔案)。',
                  '你改到「目前開啟的 block」或 data/ 底下的檔案時, 預覽會自己重畫, 不必做什麼;',
                  '但建立新 block 之後要呼叫 open_block, 否則用戶看到的還是上一個。',
                  '每輪對話開頭會附上一段 [application-context], 描述當下的狀況 — 那是執行環境給的,',
                  '不是用戶說的話。以它為準, 不要用上一輪的狀況推測現在。'
                ].join('\n'),
                // 動態: 現在是什麼狀況。每輪取一次, 附在對話尾端
                context: function() {
                  return rt.io.listBlocks().then(function(list) {
                    var v = store.value();
                    return {
                      openedBlock: sb.current() || null,
                      blocks: list.map(function(b) { return b.name; }),
                      sheet: {
                        columns: v.columns.map(function(c) { return c.name + ':' + c.type; }),
                        rowCount: v.rows.length,
                        firstRow: v.rows[0] || null
                      }
                    };
                  });
                }
              });
              if(blockName) { sb.show(blockName); }
              return create('chat', document.getElementById('chat-root'), {
                api: API, block: blockName, sandbox: sb, transport: rt.transport
              });
            });
        })
        .then(function(c) {
          chat = c;
          chat.on('block', function(name) {
            history.replaceState(null, '', location.pathname + '?block=' + encodeURIComponent(name));
          });
        })
        .catch(function(e) {
          document.body.textContent = '初始化失敗: ' + e.message;
          console.error(e);
        });
